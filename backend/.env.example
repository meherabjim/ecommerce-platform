NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=ecommerce_platform
DB_SYNC=true

JWT_SECRET=replace_with_a_long_random_secret

# Optional first-run Super Admin bootstrap.
# Set both values together only for a fresh database, then rotate/remove them
# from the deployment environment after the account exists.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000

# Optional payment providers
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=

# Optional courier providers
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_API_TOKEN=

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30


RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

